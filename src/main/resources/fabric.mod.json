{
  "schemaVersion": 1,
  "id": "mms_weapons",
  "version": "${version}",
  "name": "MMS Weapons",
  "description": "Melee and ranged weapon compat for MMSLive01. Per-item combat tuning, throwable pikes and sickles, the Bountiful Fish anchor chain throw, the focus barrage, the mace smash on hammers, tuna swing sounds, Expanded Weaponry longbow tuning, and 3D models for other mods' weapons.",
  "environment": "*",
  "entrypoints": {
    "main": [
      "info.mudbourn.mmsweapons.MmsWeapons"
    ],
    "client": [
      "info.mudbourn.mmsweapons.client.MmsWeaponsClient"
    ]
  },
  "mixins": [
    "mms_weapons.throwable.mixins.json",
    "mms_weapons.chainlink.mixins.json",
    "mms_weapons.focus.mixins.json",
    "mms_weapons.headshot.mixins.json",
    "mms_weapons.expandedweaponry.mixins.json",
    {
      "config": "mms_weapons.swing.client.mixins.json",
      "environment": "client"
    },
    {
      "config": "mms_weapons.chainlink.client.mixins.json",
      "environment": "client"
    },
    {
      "config": "mms_weapons.focus.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*",
    "basicweapons": "*",
    "expanded_weaponry": "*",
    "weaponsexpanded": "*",
    "enderscape": "*",
    "aerialhell": "*",
    "bountiful-fish": "*",
    "mutantmonsters": "*",
    "bettercombat": "*",
    "mms_render_common": "*",
    "mms_combat": "*",
    "mms_arsenal": "*"
  },
  "custom": {
    "fabric:resource_load_order": {
      "after": [
        "basicweapons",
        "expanded_weaponry",
        "weaponsexpanded",
        "bountiful-fish",
        "mutantmonsters",
        "bettercombat"
      ]
    }
  },
  "suggests": {
    "sounds": "*",
    "frostiful": "*"
  }
}
