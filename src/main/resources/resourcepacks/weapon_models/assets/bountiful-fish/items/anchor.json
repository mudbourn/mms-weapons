{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui",
          "ground",
          "fixed",
          "on_shelf"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "bountiful-fish:item/anchor_gui"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:has_component",
      "component": "mms_weapons:chain_out",
      "on_true": {
        "type": "minecraft:empty"
      },
      "on_false": {
        "type": "mms_render_common:geo",
        "base": "bountiful-fish:item/anchor_held",
        "geo": "bountiful-fish:geo/item/anchor.geo.json",
        "texture": "bountiful-fish:textures/item/anchor_3d.png"
      }
    }
  }
}
